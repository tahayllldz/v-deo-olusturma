{
  "name": "beta-studio-website-launch-reel",
  "version": "1.0.0",
  "description": "Beta Studio website launch Instagram Reel (Remotion, 1080x1920, 30 fps, 18 s)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render WebsiteLaunch-Reel ../video-output/beta-studio-website-launch-reel.mp4 --codec=h264 --crf=17 --x264-preset=slow --audio-codec=aac --audio-bitrate=320k",
    "stills": "remotion render WebsiteLaunch-Reel out/stills --sequence --frames=0-539 --image-format=jpeg",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
